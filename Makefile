	cd src/ && ( test -e Makefile.Gitnoter || $(QMAKE) -o Makefile.Gitnoter /home/kavia/workspace/code-generation/Gitnoter-239233/src/Gitnoter.pro ) && $(MAKE) -e -f Makefile.Gitnoter distdir DISTDIR=$(DISTDIR)/src

